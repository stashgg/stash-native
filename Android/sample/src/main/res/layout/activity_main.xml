<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StashPay SDK Sample"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:contentDescription="StashPay SDK Sample Application"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- URL Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/urlInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Checkout URL"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true"
                android:contentDescription="Enter the checkout URL to open" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Web View Mode Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/webViewModeSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Use Web View Mode (Chrome)"
            android:textSize="16sp"
            android:contentDescription="Toggle to use Chrome Custom Tabs instead of native card UI"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/urlInputLayout" />

        <!-- Open Checkout Button -->
        <Button
            android:id="@+id/openCheckoutButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Open Checkout"
            android:contentDescription="Open the checkout dialog with the specified URL"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/webViewModeSwitch" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status:"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/openCheckoutButton" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:text="Ready"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:contentDescription="Current status of the checkout operation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/statusLabel"
            app:layout_constraintTop_toBottomOf="@+id/openCheckoutButton" />

        <!-- Advanced Options Toggle -->
        <TextView
            android:id="@+id/advancedOptionsToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="▶ Advanced Options"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Tap to show or hide advanced configuration options"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statusLabel" />

        <!-- Advanced Options Container (Initially Hidden) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/advancedOptionsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/advancedOptionsToggle">

            <!-- Landscape Lock Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/landscapeLockSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lock to Landscape Mode"
                android:textSize="16sp"
                android:contentDescription="Toggle to lock the app to landscape orientation for testing"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Card Size Configuration Section -->
            <TextView
                android:id="@+id/sizeConfigTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Card Size Configuration"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/landscapeLockSwitch" />

            <!-- Phone Card Height Slider (sets both portrait and landscape) -->
            <TextView
                android:id="@+id/phoneHeightLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Phone Height (Portrait): 68%"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sizeConfigTitle" />

            <SeekBar
                android:id="@+id/phoneHeightSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="58"
                android:contentDescription="Adjust phone card height percentage (portrait, landscape is auto-adjusted)"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/phoneHeightLabel" />

            <!-- Tablet Width Slider (sets both portrait and landscape) -->
            <TextView
                android:id="@+id/tabletWidthLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tablet Width (Portrait): 60%"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/phoneHeightSlider" />

            <SeekBar
                android:id="@+id/tabletWidthSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="50"
                android:contentDescription="Adjust tablet card width percentage (portrait)"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabletWidthLabel" />

            <!-- Tablet Height Slider (sets both portrait and landscape) -->
            <TextView
                android:id="@+id/tabletHeightLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tablet Height (Portrait): 80%"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabletWidthSlider" />

            <SeekBar
                android:id="@+id/tabletHeightSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="90"
                android:progress="70"
                android:contentDescription="Adjust tablet card height percentage (portrait)"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabletHeightLabel"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Spacer at bottom -->
        <View
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@+id/advancedOptionsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
