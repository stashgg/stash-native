    }
}

func drainMainQueue() {
    var drained = false
    DispatchQueue.main.async { drained = true }
    let deadline = Date().addingTimeInterval(2)
    while !drained && Date() < deadline {
        RunLoop.current.run(until: Date().addingTimeInterval(0.001))
    }
    precondition(drained, "Main queue did not drain")
}

func check(_ name: String, _ body: () -> Void) {
    ProbeSession.shared.tasks.removeAll()
    StashHmac.canSign = true
    body()
    print("PASS request: \(name)")
}

check("late A cannot reopen after latest B closes") {
    let host = ViewController()
    let first = host.start()
    let second = host.start(.webshop)
    precondition(first.cancelled && second.resumed)
    second.respond("B")
    drainMainQueue()
    precondition(host.generateRequest == nil)
    // No SDK busy guard exists in this harness: B has finished and its checkout may be closed.
    first.respond("A")
    drainMainQueue()
    precondition(host.opened == ["https://example.invalid/B"] && host.alerts.isEmpty)
}
check("obsolete A arriving first cannot win against B") {
    let host = ViewController()
    let first = host.start()
    let second = host.start()
    first.respond("A")
    drainMainQueue()
    precondition(host.opened.isEmpty && host.generateRequest === second)
    second.respond("B")
    drainMainQueue()
    precondition(host.opened == ["https://example.invalid/B"])
}
check("obsolete failures do not alert or clear the new task") {
    let host = ViewController()
    let first = host.start()
    let second = host.start()
    first.respond("A", status: 500)
    drainMainQueue()
    precondition(host.alerts.isEmpty && host.generateRequest === second)
}
check("view disappearance suppresses success and failure") {
    let host = ViewController()
    for status in [200, 500] {
        let task = host.start()
        host.viewWillDisappear(false)
        precondition(task.cancelled && host.generateRequest == nil)
        task.respond("cancelled", status: status)
        drainMainQueue()
    }
    precondition(host.opened.isEmpty && host.alerts.isEmpty)
}
check("generation is checked at main-queue delivery") {
    let host = ViewController()
    let task = host.start()
    task.respond("queued")
    host.cancelGenerateRequest()
    drainMainQueue()
    precondition(host.opened.isEmpty && host.alerts.isEmpty)
}
check("current failure alerts once and releases task") {
    let host = ViewController()
    host.start().respond("failure", status: 500)
    drainMainQueue()
    precondition(host.alerts.count == 1 && host.opened.isEmpty && host.generateRequest == nil)
}
check("invalid new request cancels the prior request") {
    let host = ViewController()
    let first = host.start()
    StashHmac.canSign = false
    _ = host.start()
    first.respond("old")
    drainMainQueue()
    precondition(first.cancelled && host.opened.isEmpty && host.alerts.count == 1)
}
check("completion does not retain a departed controller") {
    var host: ViewController? = ViewController()
    let isReleased = { [weak host] in host == nil }
    let task = host!.start()
    host = nil
    precondition(isReleased() && task.cancelled)
    task.respond("departed")
    drainMainQueue()
}
print("PASS: 8 request lifetime cases")
