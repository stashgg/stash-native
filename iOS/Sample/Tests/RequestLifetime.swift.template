import Foundation

typealias URLSessionDataTask = ProbeTask

final class ProbeTask {
    var cancelled = false
    var resumed = false
    let completion: (Data?, URLResponse?, Error?) -> Void

    init(completion: @escaping (Data?, URLResponse?, Error?) -> Void) {
        self.completion = completion
    }

    func cancel() { cancelled = true }
    func resume() { resumed = true }

    // Deliberately deliver even after cancellation, as a completion can already be queued.
    func respond(_ name: String, status: Int = 200) {
        let data = Data("{\"url\":\"https://example.invalid/\(name)\"}".utf8)
        let response = HTTPURLResponse(url: URL(string: "https://example.invalid")!,
                                       statusCode: status, httpVersion: nil, headerFields: nil)
        completion(data, response, nil)
    }
}

final class ProbeSession {
    static let shared = ProbeSession()
    var tasks: [ProbeTask] = []

    func dataTask(with request: URLRequest,
                  completionHandler: @escaping (Data?, URLResponse?, Error?) -> Void) -> URLSessionDataTask {
        let task = ProbeTask(completion: completionHandler)
        tasks.append(task)
        return task
    }
}

enum StashHmac {
    static var canSign = true
    static func signature(appId: String, ingressSecretB64: String, body: Data) -> String? {
        canSign ? "fixture" : nil
    }
}

class ProbeViewController: NSObject {
    func viewWillDisappear(_ animated: Bool) {}
}

final class ViewController: ProbeViewController {
    enum PayloadKind { case checkout, webshop }
