<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 theme - Google design guidelines -->
    <style name="Theme.StashNativeDemo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/background_grouped</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Modal that fills the screen, so long JSON is comfortable to edit (parity with the iOS
         sheet). windowIsFloating=false is what turns a Dialog full-screen. -->
    <style name="Theme.StashNativeDemo.FullScreenDialog" parent="Theme.StashNativeDemo">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>
</resources>
