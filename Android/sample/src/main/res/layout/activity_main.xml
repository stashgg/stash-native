<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="StashPay SDK Sample"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- ==================== CHECKOUT SECTION ==================== -->
        
        <!-- Checkout URL Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/checkoutUrlInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Checkout URL">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/checkoutUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Open Checkout Button -->
        <Button
            android:id="@+id/openCheckoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open Checkout" />

        <!-- ==================== MODAL SECTION ==================== -->
        
        <!-- Modal URL Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/modalUrlInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Modal URL">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/modalUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Open Modal Button -->
        <Button
            android:id="@+id/openModalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open Modal"
            style="?attr/materialButtonOutlinedStyle" />

        <!-- ==================== STATUS ==================== -->
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ready"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />

        </LinearLayout>

        <!-- ==================== ADVANCED OPTIONS - CHECKOUT ==================== -->
        
        <TextView
            android:id="@+id/advancedCheckoutToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="▶ Advanced Options - Checkout"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <LinearLayout
            android:id="@+id/advancedCheckoutContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Web View Mode Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/webViewModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Use Web View Mode (Chrome)"
                android:textSize="16sp" />

            <!-- Landscape Lock Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/landscapeLockSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lock to Landscape Mode"
                android:textSize="16sp" />

            <!-- Phone Card Height -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Phone Card Height"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneCardHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 68%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/phoneCardHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="58" />

            <!-- Checkout Tablet Portrait -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tablet Size (Portrait)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checkoutTabletPortraitWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Width: 40%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/checkoutTabletPortraitWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="30" />

            <TextView
                android:id="@+id/checkoutTabletPortraitHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 50%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/checkoutTabletPortraitHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="40" />

            <!-- Checkout Tablet Landscape -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tablet Size (Landscape)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checkoutTabletLandscapeWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Width: 30%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/checkoutTabletLandscapeWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="20" />

            <TextView
                android:id="@+id/checkoutTabletLandscapeHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 60%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/checkoutTabletLandscapeHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="90"
                android:progress="50" />

        </LinearLayout>

        <!-- ==================== ADVANCED OPTIONS - MODAL ==================== -->
        
        <TextView
            android:id="@+id/advancedModalToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="▶ Advanced Options - Modal"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <LinearLayout
            android:id="@+id/advancedModalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Modal Behavior -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/modalShowDragBarSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Show Drag Bar"
                android:textSize="16sp"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/modalAllowDismissSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allow Dismiss (tap outside)"
                android:textSize="16sp"
                android:checked="true" />

            <!-- Modal Phone Portrait -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Phone Size (Portrait)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalPhonePortraitWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Width: 90%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalPhonePortraitWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="80" />

            <TextView
                android:id="@+id/modalPhonePortraitHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 70%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalPhonePortraitHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="60" />

            <!-- Modal Phone Landscape -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Phone Size (Landscape)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalPhoneLandscapeWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Width: 70%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalPhoneLandscapeWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="60" />

            <TextView
                android:id="@+id/modalPhoneLandscapeHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 85%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalPhoneLandscapeHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="75" />

            <!-- Modal Tablet Portrait -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tablet Size (Portrait)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalTabletPortraitWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Width: 60%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalTabletPortraitWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="50" />

            <TextView
                android:id="@+id/modalTabletPortraitHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 70%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalTabletPortraitHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="60" />

            <!-- Modal Tablet Landscape -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tablet Size (Landscape)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalTabletLandscapeWidthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Width: 50%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalTabletLandscapeWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="40" />

            <TextView
                android:id="@+id/modalTabletLandscapeHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Height: 80%"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/modalTabletLandscapeHeightSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="90"
                android:progress="70" />

        </LinearLayout>

        <!-- Bottom spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
