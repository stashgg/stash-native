<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:minHeight="48dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/actionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.StashNative.TitleMedium"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/actionValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:maxWidth="160dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.StashNative.BodySmall"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/actionChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_ms_chevron_right_24"
        android:contentDescription="@null" />
</LinearLayout>
