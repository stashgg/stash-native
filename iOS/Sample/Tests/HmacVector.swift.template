import Foundation

func check(_ name: String, _ body: () -> Void) {
    body()
    print("PASS hmac: \(name)")
}

// Shared with the Android sample test: appId app_test, secret base64 of "secret-key", body "{}",
// timestamp 1700000000000. Expected header computed independently with Python hmac/sha256.
let secret = "c2VjcmV0LWtleQ=="
let body = Data("{}".utf8)
let millis: Int64 = 1_700_000_000_000
let expected = "v1;app_test;1700000000000;BcQuOn6SZzdxDZnMg0flRAhb9SVL0H2seNBiU2W+Mq4="

check("shared vector produces the documented header") {
    let signature = StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: body, unixMillis: millis)
    precondition(signature == expected, signature ?? "nil")
}
check("unpadded secret signs identically to the padded one") {
    let signature = StashHmac.signature(appId: "app_test", ingressSecretB64: "c2VjcmV0LWtleQ", body: body,
                                        unixMillis: millis)
    precondition(signature == expected)
}
// Shared with the Android StashHmacTest: both samples accept and reject exactly these secrets.
let acceptedSecrets = ["c2VjcmV0LWtleQ==", "c2VjcmV0LWtleQ", " c2VjcmV0LWtleQ\n", "abc", "abc=", "aQ==", "Pz8/Pj4+"]
let rejectedSecrets = ["", " \n", "a", "abcde", "abcd=", "c2VjcmV0LWtleQ=", "ab=c", "====", "not base64!",
                       "c2Vj cmV0LWtleQ"]
check("shared secret vectors match the Android rule, and only accepted secrets sign") {
    for secret in acceptedSecrets {
        precondition(StashHmac.isValidIngressSecret(secret), secret)
        precondition(StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: body,
                                         unixMillis: millis) != nil, secret)
    }
    for secret in rejectedSecrets {
        precondition(!StashHmac.isValidIngressSecret(secret), secret)
        precondition(StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: body,
                                         unixMillis: millis) == nil, secret)
    }
}
check("the body bytes and timestamp both change the signature") {
    let otherBody = StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: Data("{ }".utf8),
                                        unixMillis: millis)
    let otherTime = StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: body,
                                        unixMillis: millis + 1)
    precondition(otherBody != expected && otherTime != expected)
}
check("clock overload emits the same format with the current millisecond timestamp") {
    let before = Int64(Date().timeIntervalSince1970 * 1000)
    guard let signature = StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: body) else {
        preconditionFailure("clock overload must sign a valid secret")
    }
    let parts = signature.split(separator: ";", omittingEmptySubsequences: false)
    precondition(parts.count == 4 && parts[0] == "v1" && parts[1] == "app_test")
    guard let signedMillis = Int64(parts[2]) else { preconditionFailure("timestamp must be integer millis") }
    precondition(signedMillis >= before && signedMillis <= Int64(Date().timeIntervalSince1970 * 1000))
    precondition(StashHmac.signature(appId: "app_test", ingressSecretB64: secret, body: body,
                                     unixMillis: signedMillis) == signature)
}
print("PASS: 5 HMAC signing cases")
