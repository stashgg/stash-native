{
  "name": "stash-robot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || >=24.0.0", "npm": ">=10" },
  "scripts": {
    "build": "tsc && esbuild web/app.ts --bundle --format=esm --outfile=dist/web/app.js --target=es2022",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/launch.mjs start",
    "doctor": "node scripts/launch.mjs doctor",
    "stop": "node scripts/launch.mjs stop",
    "reset-device": "node scripts/launch.mjs reset-device",
    "test": "tsx --test test/*.test.ts",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "8.6.1",
    "appium-xcuitest-driver": "12.11.0",
    "webdriverio": "9.31.7",
    "ws": "8.18.3",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.10",
    "typescript": "5.9.2",
    "@playwright/test": "1.55.1"
  }
}
