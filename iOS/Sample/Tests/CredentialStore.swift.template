var storedData: Data?
var readStatus = errSecSuccess
var updateStatus = errSecSuccess
var addStatus = errSecSuccess
var invalidResult = false
var updateCount = 0
var addCount = 0
var updateAccessible: String?
var addAccessible: String?

func probeSecItemCopyMatching(_ query: CFDictionary, _ result: UnsafeMutablePointer<CFTypeRef?>?) -> OSStatus {
    if readStatus == errSecSuccess {
        result?.pointee = invalidResult ? "invalid fixture" as CFString : storedData as CFData?
    }
    return readStatus
}
func probeSecItemUpdate(_ query: CFDictionary, _ attributes: CFDictionary) -> OSStatus {
    updateCount += 1
    updateAccessible = (attributes as NSDictionary)[kSecAttrAccessible] as? String
    if updateStatus == errSecSuccess { storedData = (attributes as NSDictionary)[kSecValueData] as? Data }
    return updateStatus
}
func probeSecItemAdd(_ query: CFDictionary, _ result: UnsafeMutablePointer<CFTypeRef?>?) -> OSStatus {
    addCount += 1
    addAccessible = (query as NSDictionary)[kSecAttrAccessible] as? String
    if addStatus == errSecSuccess { storedData = (query as NSDictionary)[kSecValueData] as? Data }
    return addStatus
}

final class ViewController {
    enum PayloadKind { case checkout, webshop }
    // INSERT_PROPERTIES
    static let defaultCheckoutPayload = "{\"checkout\":true}"
    static let defaultWebshopPayload = "{\"webshop\":true}"
    var alerts: [String] = []
    func showAlert(title: String, message: String) { alerts.append(message) }
    func reloadApiSection() {}
    // INSERT_METHODS
}

let original = ApiKeyEntry(id: "custom", name: "custom fixture", appId: "custom-app", key: "fixture",
                           production: false, checkoutPayload: "{}", webshopPayload: "{}")
let initial = try JSONEncoder().encode(ApiKeyStore.Payload(keys: [original], selectedId: original.id))
let importDocument = """
{"version":2,"instances":[{"name":"import fixture","appId":"import-app","ingressSecret":"fixture"}]}
"""

func check(_ name: String, _ body: () throws -> Void) rethrows {
    storedData = initial
    readStatus = errSecSuccess
    updateStatus = errSecSuccess
    addStatus = errSecSuccess
    invalidResult = false
    updateCount = 0
    addCount = 0
    updateAccessible = nil
    addAccessible = nil
    try body()
    print("PASS storage: \(name)")
}

func requireError(_ body: () throws -> Void) {
    do {
        try body()
        preconditionFailure("Expected storage error")
    } catch { }
}

try check("missing differs from a saved payload") {
    let payload = try ApiKeyStore.load()
    precondition(payload?.keys.first?.id == original.id)
    readStatus = errSecItemNotFound
    let missing = try ApiKeyStore.load()
    precondition(missing == nil)
}
check("read error preserves bytes even if future writes would succeed") {
    readStatus = errSecInteractionNotAllowed
    let host = ViewController()
    host.loadApiKeys()
    readStatus = errSecSuccess
    host.setInstanceName(host.apiKeys[0].id, "edited")
    precondition(!host.saveApiKeys())
    precondition(storedData == initial && updateCount == 0 && addCount == 0)
    precondition(!host.canSaveApiKeys && host.alerts.count == 1)
}
check("malformed saved payload is preserved") {
    storedData = Data("not json".utf8)
    let before = storedData
    let host = ViewController()
    host.loadApiKeys()
    precondition(!host.saveApiKeys() && storedData == before && updateCount == 0)
    precondition(host.alerts.count == 1)
}
check("unexpected Keychain result type is an error") {
    invalidResult = true
    requireError { _ = try ApiKeyStore.load() }
    precondition(updateCount == 0 && storedData == initial)
}
check("new install seeds defaults only when item is missing") {
    storedData = nil
    readStatus = errSecItemNotFound
    updateStatus = errSecItemNotFound
    let host = ViewController()
    host.loadApiKeys()
    precondition(host.canSaveApiKeys && host.alerts.isEmpty)
    precondition(storedData != nil && updateCount == 1 && addCount == 1)
}
check("failed update reports failure without inserting or changing bytes") {
    updateStatus = errSecNotAvailable
    requireError { try ApiKeyStore.save(keys: [], selectedId: nil) }
    precondition(storedData == initial && updateCount == 1 && addCount == 0)
}
check("failed insert reports failure") {
    updateStatus = errSecItemNotFound
    addStatus = errSecNotAvailable
    requireError { try ApiKeyStore.save(keys: [], selectedId: nil) }
    precondition(storedData == initial && updateCount == 1 && addCount == 1)
}
check("typed edits stay in memory; the screen-exit save warns once and a later save recovers") {
    let host = ViewController()
    host.loadApiKeys()
    let beforeFailure = storedData
    let writesAfterLoad = updateCount
    updateStatus = errSecNotAvailable
    host.setInstanceName(original.id, "one")
    host.setInstanceName(original.id, "two")
    precondition(updateCount == writesAfterLoad && host.alerts.isEmpty && host.apiKeys[0].name == "two")
    host.persistInstances()
    host.persistInstances()
    precondition(host.alerts.count == 1 && storedData == beforeFailure)
    updateStatus = errSecSuccess
    precondition(host.saveApiKeys() && !host.didShowCredentialSaveError)
    precondition(storedData != initial)
}
check("payload caller receives failed and successful save results") {
    let host = ViewController()
    host.loadApiKeys()
    updateStatus = errSecNotAvailable
    precondition(!host.saveInstancePayload(original.id, .checkout, "changed"))
    precondition(host.apiKeys[0].checkoutPayload == "changed" && host.alerts.isEmpty)
    updateStatus = errSecSuccess
    precondition(host.saveInstancePayload(original.id, .checkout, "saved"))
}
check("import caller receives save failure while retaining session entries") {
    let host = ViewController()
    host.loadApiKeys()
    let beforeFailure = storedData
    updateStatus = errSecNotAvailable
    let result = host.importInstancesJson(importDocument)
    precondition(result?.added == 1 && result?.saved == false)
    precondition(host.apiKeys.count == 2 && storedData == beforeFailure && host.alerts.isEmpty)
}
check("read failure blocks payload and import persistence") {
    readStatus = errSecNotAvailable
    let host = ViewController()
    host.loadApiKeys()
    precondition(!host.saveInstancePayload(host.apiKeys[0].id, .webshop, "session-only"))
    precondition(host.apiKeys[0].webshopPayload == "session-only")
    precondition(host.importInstancesJson(importDocument)?.saved == false)
    precondition(storedData == initial && updateCount == 0)
}
check("updates and inserts are device-local, migrating items saved with the old class") {
    let deviceOnly = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly as String
    let host = ViewController()
    host.loadApiKeys()
    precondition(updateCount == 1 && addCount == 0 && updateAccessible == deviceOnly)
    storedData = nil
    readStatus = errSecItemNotFound
    updateStatus = errSecItemNotFound
    ViewController().loadApiKeys()
    precondition(addCount == 1 && addAccessible == deviceOnly)
}
// INSERT_FIXTURE
try check("shared v2 export fixture imports every field and the exporter emits its key set") {
    let fixture = try JSONSerialization.jsonObject(with: Data(sharedExportFixture.utf8)) as! [String: Any]
    let wanted = fixture["instances"] as! [[String: Any]]
    let host = ViewController()
    host.loadApiKeys()
    precondition(host.importInstancesJson(sharedExportFixture)?.added == wanted.count)
    for (index, want) in wanted.enumerated() {
        let got = host.apiKeys[index + 1]
        precondition(got.name == want["name"] as? String)
        precondition(got.appId == want["appId"] as? String)
        precondition(got.key == want["ingressSecret"] as? String)
        precondition(got.production == want["production"] as? Bool)
        precondition(got.checkoutPayload == want["checkoutPayload"] as? String)
        precondition(got.webshopPayload == want["webshopPayload"] as? String)
    }
    let secret = wanted[0]["ingressSecret"] as! String
    precondition(wanted[0]["production"] as? Bool == true && secret.contains("/"))
    let text = host.exportInstancesJson()
    let exported = try JSONSerialization.jsonObject(with: Data(text.utf8)) as! [String: Any]
    precondition(Set(exported.keys) == Set(fixture.keys) && exported["version"] as? Int == 2)
    precondition(exported["version"] as? Int == fixture["version"] as? Int)
    let instances = exported["instances"] as! [[String: Any]]
    precondition(instances.count == wanted.count + 1)
    for instance in instances { precondition(Set(instance.keys) == Set(wanted[0].keys)) }
    for (index, want) in wanted.enumerated() {
        precondition(NSDictionary(dictionary: instances[index + 1]).isEqual(to: want))
    }
    // Like Android, the export leaves the '/' in base64 secrets unescaped.
    precondition(text.contains("\"\(secret)\""))
}
check("typed edits persist when the app resigns active, and only when something changed") {
    let host = ViewController()
    host.loadApiKeys()
    var writes = updateCount
    host.flushPendingInstanceEdits()
    precondition(updateCount == writes)
    let edits: [(String) -> Void] = [
        { host.setInstanceName(original.id, $0) },
        { host.setInstanceAppId(original.id, $0) },
        { host.setInstanceSecret(original.id, $0) }
    ]
    for edit in edits {
        edit("edited")
        precondition(updateCount == writes)
        host.flushPendingInstanceEdits()
        host.flushPendingInstanceEdits()
        writes += 1
        precondition(updateCount == writes)
    }
    let saved = try? JSONDecoder().decode(ApiKeyStore.Payload.self, from: storedData ?? Data())
    let entry = saved?.keys.first
    precondition(entry?.name == "edited" && entry?.appId == "edited" && entry?.key == "edited")
}
check("a failed flush keeps the edits pending for the next one") {
    let host = ViewController()
    host.loadApiKeys()
    let writes = updateCount
    updateStatus = errSecNotAvailable
    host.setInstanceName(original.id, "retry")
    host.flushPendingInstanceEdits()
    precondition(host.hasPendingInstanceEdits && host.alerts.count == 1)
    updateStatus = errSecSuccess
    host.flushPendingInstanceEdits()
    precondition(!host.hasPendingInstanceEdits && updateCount == writes + 2)
}
try check("superseded bundled secrets migrate to the current demo credential; other entries stay") {
    let stale = ApiKeyEntry(id: "stale", name: "old name", appId: "old-app",
                            key: ViewController.supersededBundledSecrets[0], production: false,
                            checkoutPayload: "{}", webshopPayload: "{}")
    storedData = try JSONEncoder().encode(ApiKeyStore.Payload(keys: [stale, original], selectedId: stale.id))
    let host = ViewController()
    host.loadApiKeys()
    let migrated = host.apiKeys[0]
    precondition(migrated.id == "stale" && migrated.name == ViewController.defaultStashKeyName)
    precondition(migrated.appId == ViewController.defaultStashAppId
                 && migrated.key == ViewController.defaultStashApiKey)
    precondition(host.apiKeys[1].name == original.name && host.apiKeys[1].key == original.key)
    let saved = try JSONDecoder().decode(ApiKeyStore.Payload.self, from: storedData ?? Data())
    precondition(saved.keys[0].key == ViewController.defaultStashApiKey && saved.selectedId == "stale")
}
// INSERT_IMPORT_CASES
try check("shared malformed imports: a bad credential rejects the document, bad optional fields are absent") {
    let cases = try JSONSerialization.jsonObject(with: Data(sharedImportCases.utf8)) as? [String: Any]
    let rejected = cases?["rejected"] as? [Any] ?? []
    precondition(rejected.count == 4)
    for document in rejected {
        let host = ViewController()
        host.loadApiKeys()
        let text = String(decoding: try JSONSerialization.data(withJSONObject: document), as: UTF8.self)
        precondition(host.importInstancesJson(text) == nil, text)
        precondition(host.apiKeys.count == 1)
    }
    let host = ViewController()
    host.loadApiKeys()
    let absent = try JSONSerialization.data(withJSONObject: cases?["optionalFieldsAbsent"] ?? [:])
    precondition(host.importInstancesJson(String(decoding: absent, as: UTF8.self))?.added == 1)
    let imported = host.apiKeys[1]
    precondition(imported.name == "Untitled" && !imported.production)
    precondition(imported.checkoutPayload == ViewController.defaultCheckoutPayload)
    precondition(imported.webshopPayload == ViewController.defaultWebshopPayload)
}
