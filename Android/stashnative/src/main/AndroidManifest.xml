<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <application>
        <activity
            android:name=".StashNativeCardPortraitActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:theme="@style/StashNativeCardTheme" />

        <service
            android:name=".StashKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>
