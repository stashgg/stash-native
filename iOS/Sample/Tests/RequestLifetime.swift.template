func drainMainQueue() {
    var drained = false
    DispatchQueue.main.async { drained = true }
    let deadline = Date().addingTimeInterval(2)
    while !drained && Date() < deadline {
        RunLoop.current.run(until: Date().addingTimeInterval(0.001))
    }
    precondition(drained, "Main queue did not drain")
}

func check(_ name: String, _ body: () -> Void) {
    ProbeSession.shared.tasks.removeAll()
    ProbeSession.shared.requests.removeAll()
    StashHmac.canSign = true
    StashHmac.signed.removeAll()
    StashNative.shared.opens.removeAll()
    body()
    print("PASS request: \(name)")
}

check("late A cannot reopen after latest B closes") {
    let host = ViewController()
    let first = host.start()
    let second = host.start(.webshop)
    precondition(first.cancelled && second.resumed)
    second.respond("B")
    drainMainQueue()
    precondition(host.generateRequest == nil)
    // No SDK busy guard exists in this harness: B has finished and its checkout may be closed.
    first.respond("A")
    drainMainQueue()
    precondition(host.opened == ["https://example.invalid/B"] && host.alerts.isEmpty)
}
check("obsolete A arriving first cannot win against B") {
    let host = ViewController()
    let first = host.start()
    let second = host.start()
    first.respond("A")
    drainMainQueue()
    precondition(host.opened.isEmpty && host.generateRequest === second)
    second.respond("B")
    drainMainQueue()
    precondition(host.opened == ["https://example.invalid/B"])
}
check("obsolete failures do not alert or clear the new task") {
    let host = ViewController()
    let first = host.start()
    let second = host.start()
    first.respond("A", status: 500)
    drainMainQueue()
    precondition(host.alerts.isEmpty && host.generateRequest === second)
}
check("view disappearance suppresses success and failure") {
    let host = ViewController()
    for status in [200, 500] {
        let task = host.start()
        host.viewWillDisappear(false)
        precondition(task.cancelled && host.generateRequest == nil)
        task.respond("cancelled", status: status)
        drainMainQueue()
    }
    precondition(host.opened.isEmpty && host.alerts.isEmpty)
}
check("generation is checked at main-queue delivery") {
    let host = ViewController()
    let task = host.start()
    task.respond("queued")
    host.cancelGenerateRequest()
    drainMainQueue()
    precondition(host.opened.isEmpty && host.alerts.isEmpty)
}
check("current failure alerts once and releases task") {
    let host = ViewController()
    host.start().respond("failure", status: 500)
    drainMainQueue()
    precondition(host.alerts.count == 1 && host.opened.isEmpty && host.generateRequest == nil)
}
check("invalid new request cancels the prior request") {
    let host = ViewController()
    let first = host.start()
    StashHmac.canSign = false
    _ = host.start()
    first.respond("old")
    drainMainQueue()
    precondition(first.cancelled && host.opened.isEmpty && host.alerts.count == 1)
}
check("blank app ID alerts without a request and still supersedes the prior one") {
    let host = ViewController()
    let first = host.start()
    let taskCount = ProbeSession.shared.tasks.count
    host.apiKeys[0].appId = " "
    _ = host.start()
    precondition(ProbeSession.shared.tasks.count == taskCount && first.cancelled && host.generateRequest == nil)
    precondition(host.alerts == ["App ID and ingress secret are both required"])
    first.respond("old")
    drainMainQueue()
    precondition(host.opened.isEmpty && host.alerts.count == 1)
}
check("completion does not retain a departed controller") {
    var host: ViewController? = ViewController()
    let isReleased = { [weak host] in host == nil }
    let task = host!.start()
    host = nil
    precondition(isReleased() && task.cancelled)
    task.respond("departed")
    drainMainQueue()
}
// A-102: the selected instance signs or nothing does; the bundled credential is never substituted.
check("a missing selection or blank secret signs nothing, not the bundled credential") {
    let host = ViewController()
    host.selectedApiKeyId = "deleted"
    host.request()
    host.selectedApiKeyId = "selected"
    host.apiKeys[0].key = "\n"
    host.request()
    precondition(ProbeSession.shared.tasks.isEmpty && StashHmac.signed.isEmpty)
    precondition(host.alerts == Array(repeating: "App ID and ingress secret are both required", count: 2))
}
check("the selected instance supplies the credential, environment and payload") {
    let host = ViewController()
    host.apiKeys.append(ApiKeyEntry(id: "production", name: "live", appId: " live-app ", key: "live-secret\n",
                                    production: true, checkoutPayload: "{\"live\":1}", webshopPayload: "{}"))
    host.selectedApiKeyId = "production"
    _ = host.start()
    let request = ProbeSession.shared.requests[0]
    precondition(StashHmac.signed.count == 1 && StashHmac.signed[0] == ("live-app", "live-secret"))
    precondition(request.url?.absoluteString == "https://api.stash.gg/sdk/server/checkout_links/generate_quick_pay_url")
    precondition(request.httpBody == Data("{\"live\":1}".utf8))
    host.selectedApiKeyId = "selected"
    _ = host.start(.webshop)
    precondition(ProbeSession.shared.requests[1].url?.host == "test-api.stash.gg")
}
// A-096: a manual open supersedes the pending generate request, so its late response cannot open.
check("manual card, browser and scanner opens supersede a pending generate") {
    let host = ViewController()
    let opens: [(String, () -> Void)] = [
        ("card https://example.invalid/card", host.openCardTapped),
        ("browser https://example.invalid/browser", host.openBrowserTapped),
        ("scanner", host.openScannerTapped)
    ]
    for (expected, open) in opens {
        let pending = host.start()
        open()
        precondition(pending.cancelled && host.generateRequest == nil)
        precondition(StashNative.shared.opens.last == expected)
        pending.respond("late")
        drainMainQueue()
    }
    precondition(host.opened.isEmpty && host.alerts.isEmpty && StashNative.shared.opens.count == 3)
}
