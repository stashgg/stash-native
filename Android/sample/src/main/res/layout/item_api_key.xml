<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/apiKeyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:minHeight="56dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/apiKeySelected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_radio_unselected_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/instance_select" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/apiKeyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.StashNative.TitleMedium"
            tools:text="Demo Key" />

        <TextView
            android:id="@+id/apiKeyMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.StashNative.BodySmall"
            tools:text="Test" />
    </LinearLayout>

    <ImageView
        android:id="@+id/apiKeyChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_ms_chevron_right_24"
        android:contentDescription="@null" />
</LinearLayout>
